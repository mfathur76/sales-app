// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Outlet {
  id       String @id @default(cuid())
  code     String @unique
  name     String
  password String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relation to sales
  sales OutletSale[]
}

model OutletSale {
  outlet      String
  date        DateTime
  cash        Float    @default(0)
  qris        Float    @default(0)
  gojek       Float    @default(0)
  shopee      Float    @default(0)
  grab        Float    @default(0)
  totalSales  Float    @default(0)
  
  // Bank transfer amounts (input by admin)
  cashBank    Float    @default(0)
  qrisBank    Float    @default(0)
  gojekBank   Float    @default(0)
  shopeeBank  Float    @default(0)
  grabBank    Float    @default(0)
  totalBank   Float    @default(0)
  
  // Percentage calculations (auto-calculated)
  cashPercent    Float    @default(0)
  qrisPercent    Float    @default(0)
  gojekPercent   Float    @default(0)
  shopeePercent  Float    @default(0)
  grabPercent    Float    @default(0)
  overallPercent Float    @default(0)
  
  // Status for approval workflow
  status      String    @default("pending") // pending, verified, approved, rejected
  verifiedBy  String?   // admin username who verified
  verifiedAt  DateTime?
  notes       String?   // admin notes
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relation to outlet
  outletRef Outlet @relation(fields: [outlet], references: [code])
  
  // Relation to admin who verified
  verifiedByRef Admin? @relation("VerifiedByAdmin", fields: [verifiedBy], references: [username])

  @@id([outlet, date])
  @@map("outlet_sales")
}

model Admin {
  id        String   @id @default(cuid())
  username  String   @unique
  name      String
  password  String
  role      String   @default("admin") // admin, super_admin
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relation to verified sales
  verifiedSales OutletSale[] @relation("VerifiedByAdmin")
}
