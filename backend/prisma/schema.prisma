// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Outlet {
  id       String @id @default(cuid())
  code     String @unique
  name     String
  password String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relation to sales
  sales OutletSale[]
  // Relation to expenses
  expenses Expense[]
}

model OutletSale {
  outlet      String
  date        DateTime
  cash        Float    @default(0)
  qris        Float    @default(0)
  gojek       Float    @default(0)
  shopee      Float    @default(0)
  grab        Float    @default(0)
  totalSales  Float    @default(0)
  
  // Bank transfer amounts (input by admin) - only for digital payments
  qrisBank    Float    @default(0)
  gojekBank   Float    @default(0)
  shopeeBank  Float    @default(0)
  grabBank    Float    @default(0)
  bcaBank     Float    @default(0)  // Transfer to BCA account
  mandiriBank Float    @default(0)  // Transfer to Mandiri account
  totalBank   Float    @default(0)
  
  // Percentage calculations (auto-calculated) - only for digital payments
  qrisPercent    Float    @default(0)
  gojekPercent   Float    @default(0)
  shopeePercent  Float    @default(0)
  grabPercent    Float    @default(0)
  bcaPercent     Float    @default(0)
  mandiriPercent Float    @default(0)
  overallPercent Float    @default(0)
  
  // Status for approval workflow
  status      String    @default("pending") // pending, verified, approved, rejected
  verifiedBy  String?   // admin username who verified
  verifiedAt  DateTime?
  notes       String?   // admin notes
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relation to outlet
  outletRef Outlet? @relation(fields: [outlet], references: [code])
  
  // Relation to admin who verified
  verifiedByRef Admin? @relation("VerifiedByAdmin", fields: [verifiedBy], references: [username])

  @@id([outlet, date])
  @@map("outlet_sales")
}

model Admin {
  id        String   @id @default(cuid())
  username  String   @unique
  name      String
  password  String
  role      String   @default("admin") // admin, super_admin
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relation to verified sales
  verifiedSales OutletSale[] @relation("VerifiedByAdmin")
  // Relation to expenses
  expenses Expense[] @relation("CreatedByAdmin")
  approvedExpenses Expense[] @relation("ApprovedByAdmin")
}

model ExpenseCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  items ItemMaster[]

  @@map("expense_categories")
}

model ItemMaster {
  id            String   @id @default(cuid())
  name          String   @unique
  categoryId    String
  standardPrice Float?   // Optional reference price
  unit          String   @default("kg") // kg, pcs, liter, etc.
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  categoryRef ExpenseCategory? @relation(fields: [categoryId], references: [id])
  expenses Expense[]

  @@map("item_masters")
}

model Expense {
  id          String   @id @default(cuid())
  outlet      String
  itemId      String   // Reference to ItemMaster
  date        DateTime
  quantity    Float    @default(1)
  actualPrice Float    // Price actually paid
  totalPrice  Float
  notes       String?
  // Payment method tracking
  isCash      Boolean  @default(true)
  
  // Status for approval workflow
  status      String    @default("pending") // pending, approved, rejected
  approvedBy  String?   // admin username who approved
  approvedAt  DateTime?
  rejectionReason String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?  // admin username who created (optional for outlet users)

  // Relations
  outletRef Outlet? @relation(fields: [outlet], references: [code])
  itemRef ItemMaster? @relation(fields: [itemId], references: [id])
  createdByRef Admin? @relation("CreatedByAdmin", fields: [createdBy], references: [username])
  approvedByRef Admin? @relation("ApprovedByAdmin", fields: [approvedBy], references: [username])

  @@map("expenses")
}
