{
  "name": "sales-app-backend",
  "version": "1.0.0",
  "description": "Sales App Backend API",
  "scripts": {
    "build:lambda": "tsc -p lambda/tsconfig.json --noEmit",
    "deploy:lambda": "npm run build:lambda && node node_modules/serverless/bin/serverless.js deploy",
    "deploy:lambda:dev": "npm run build:lambda && node node_modules/serverless/bin/serverless.js deploy --stage dev",
    "package:lambda": "npm run build:lambda && node node_modules/serverless/bin/serverless.js package --package .sls-package",
    "deploy:lambda:pkg": "node node_modules/serverless/bin/serverless.js deploy --package .sls-package",
    "offline": "npm run build:lambda && node node_modules/serverless/bin/serverless.js offline --stage dev",
    "reset:admin": "ts-node -P lambda/tsconfig.json lambda/scripts/reset-admin-password.ts",
    "promote:admin": "ts-node -P lambda/tsconfig.json lambda/scripts/set-admin-role.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1022.0",
    "@aws-sdk/lib-dynamodb": "^3.1022.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "jsonwebtoken": "^9.0.2",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.161",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.10.2",
    "@types/uuid": "^10.0.0",
    "esbuild": "^0.27.7",
    "serverless": "^3.40.0",
    "serverless-esbuild": "^1.57.0",
    "serverless-offline": "^13.9.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
