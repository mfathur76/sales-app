# Production Environment Variables
NODE_ENV=production
PORT=3001

# Database
DATABASE_URL="file:./data/sales.db"

# JWT Secret (CHANGE THIS IN PRODUCTION!)
JWT_SECRET=my-super-secret-jwt-key-for-sales-app-2024-production

# CORS Settings (AWS S3/CloudFront frontend origin)
# Single origin example:
# CORS_ALLOWED_ORIGINS=https://d111111abcdef8.cloudfront.net
# Multiple origins example (comma separated):
# CORS_ALLOWED_ORIGINS=https://d111111abcdef8.cloudfront.net,https://your-domain.com
CORS_ALLOWED_ORIGINS=https://your-frontend-domain

# Logging
LOG_LEVEL=info 