# Production Environment Variables
NODE_ENV=production
PORT=3001

# Database
DATABASE_URL="file:./data/sales.db"

# JWT Secret (CHANGE THIS IN PRODUCTION!)
JWT_SECRET=my-super-secret-jwt-key-for-sales-app-2024-production

# CORS Settings (gunakan IP server DO)
CORS_ORIGIN=http://your-server-ip:3000

# Logging
LOG_LEVEL=info 